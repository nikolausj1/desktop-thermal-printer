# Print worker configuration (lives in C:\Services\DesktopThermalPrinter\config\worker.env on the NUC).
# The worker connects to Postgres directly through Supabase's pooler (session mode, port 5432)
# as the papertelegram_worker role, which can execute only the four worker functions.
# postgresql://papertelegram_worker.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
WORKER_ID=desktop-printer-nuc
WORKER_VERSION=0.5.0

# Printer configuration.
PRINTER_ID=desk-rp820
PRINTER_IP=192.168.4.77
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=5000
PRINTER_STATUS_URL=http://192.168.4.77/prn_stat.htm
DISPLAY_TIMEZONE=America/Los_Angeles
HEARTBEAT_INTERVAL_SECONDS=15
# Poll quickly only while there is work; idle polling is the slow one.
POLL_INTERVAL_SECONDS=2
POLL_IDLE_INTERVAL_SECONDS=5
CLOUD_TIMEOUT_MS=10000
