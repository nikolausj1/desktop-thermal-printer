# Runtime configuration for the Paper Telegram site (set in Vercel project settings).
# Names only. Values live in Vercel and in Justin's 1Password; never commit them.

# The queue. The site connects to Postgres directly through Supabase's pooler
# (transaction mode, port 6543) as the papertelegram_site role, which can only
# execute the public queue functions and the dashboard read.
# postgresql://papertelegram_site.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Salt for the hashed sender address used by the rate limits. Any long random
# string; changing it resets the per-connection counters once.
IP_HASH_SALT=

# live = telegrams print. hold = every telegram is parked for review instead.
PUBLIC_API_MODE=live

# Private family links as key:label,key:label. Each key is a secret path on
# papertelegram.com (one per household, one for the printer sticker, one
# general). Rotate a link by replacing its key, then redeploy.
FAMILY_KEYS=

# live = the public root prints (the original behavior). demo = the public
# root is the demo that sends notes to Justin, and only family links print.
ROOT_MODE=demo

# Private dashboard at /dash?key=...
DASH_KEY=
