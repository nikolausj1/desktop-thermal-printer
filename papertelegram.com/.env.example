# Runtime configuration for the Paper Telegram site (set in Vercel project settings).
# Names only. Values live in Vercel and in Justin's 1Password; never commit them.

# Private family links as key:label,key:label. Each key is a secret path on
# papertelegram.com (one per household, one for the printer sticker, one
# general). Rotate a link by replacing its key, then redeploy.
FAMILY_KEYS=

# Shared secret that proves a request came through this site's /api/printer
# proxy. Must match the PROXY_KEY secret on the Supabase public-api function.
PROXY_KEY=

# live = the public root prints (today's behavior). demo = the public root is
# the demo that sends notes to Justin, and only family links print.
ROOT_MODE=live

# Private dashboard at /dash?key=... and its read access to the queue.
DASH_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
